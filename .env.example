# Copy to .env in the repo root (or export in your shell).
# Cloud services are optional — the app always falls back to MOCK mode.

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/imu

# --- Backend CORS ---
FRONTEND_ORIGIN=http://localhost:3000

# --- xAI Grok (optional) ---
# When unset, grok_service.py returns a deterministic mock analysis.
GROK_API_KEY=
GROK_MODEL=grok-3
GROK_API_BASE=https://api.x.ai/v1

# --- RunPod (optional) ---
# When unset, runpod_service.py returns a mock classification.
# Cloud inference NEVER drives the haptic motor.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
